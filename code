function img = preprocessXray(img)
    if size(img, 3) == 3
        img = rgb2gray(img);
    end
    img = imresize(img, [224 224]);
    img = im2single(img);
end
Features extraction 
function features = extractPneumoniaFeatures(img)
   img = preprocessXray(img);
    I = double(img);
    hogFeatures = manualHOG(I);
    intensityFeatures = [ ...
        mean(I(:)), ...
        std(I(:)), ...
        var(I(:)), ...
        min(I(:)), ...
        max(I(:)), ...
        median(I(:)), ...
        prctile(I(:), 10), ...
        prctile(I(:), 25), ...
        prctile(I(:), 75), ...
        prctile(I(:), 90)];
    [Gx, Gy] = gradient(I);
    Gmag = hypot(Gx, Gy);
 localVar = stdfilt(I, true(3));
    textureFeatures = [ ...
        mean(localVar(:)), ...
        std(localVar(:)), ...
        mean(abs(Gx(:))), ...
        mean(abs(Gy(:))), ...
        std(Gmag(:)), ...
        mean(Gmag(:))];
    BW = I > graythresh(I);
   areaValue = nnz(BW);
    perimeterValue = sum(bwperim(BW), "all");
    [rows, cols] = find(BW);
    if isempty(rows)
        heightValue = 0;
        widthValue = 0;
    else
        heightValue = max(rows) - min(rows) + 1;
        widthValue = max(cols) - min(cols) + 1;
    end
    if widthValue > 0
        aspectRatio = heightValue / widthValue;
    else
        aspectRatio = 0;
    end
    equivalentDiameter = sqrt(4 * areaValue / pi);
  shapeFeatures = [ …     areaValue, perimeterValue, ...
        heightValue, widthValue, ...
        aspectRatio, equivalentDiameter];
        features = [hogFeatures, intensityFeatures, ...
                textureFeatures, shapeFeatures];
end

Manual HOG Feature Extraction
function hog = manualHOG(I)
  I = imresize(I, [224 224]);
    [Gx, Gy] = gradient(I);
 magnitude = hypot(Gx, Gy);
    angle = mod(atan2d(Gy, Gx), 180);
    cellSize = 8;
    numBins = 9;
    hog = zeros(28, 28, numBins);
  for r = 1:28
        for c = 1:28
     rr = (r-1)*cellSize + (1:cellSize);
            cc = (c-1)*cellSize + (1:cellSize);
    magCell = magnitude(rr, cc);
            angCell = angle(rr, cc);
    binIndex = floor(angCell / 20) + 1;
           binIndex = min(binIndex, numBins);
U  for b = 1:numBins
                hog(r,c,b) = sum( ...
                    magCell(binIndex == b), "all");
            end
        end
    end
  hog = hog(:)';
end
